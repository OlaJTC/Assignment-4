        "# Task 10: Map, Reduce, and Filter\n",
        "# Use map to square all numbers in a list.\n",
        "# Use reduce to find the product of all numbers in a list.\n",
        "# Use filter to get only even numbers from a list.\n",
        "\n",
        "numbers = [1, 2, 3, 4, 5]\n",
        "\n",
        "# Your code here:\n",
        "numbers = [1, 2, 3, 4, 5]\n",
        "\n",
        "# 1. Use map to square all numbers in a list\n",
        "squared = list(map(lambda x: x * x, numbers))\n",
        "\n",
        "# 2. Use reduce to find the product of all numbers in a list\n",
        "product = reduce(lambda x, y: x * y, numbers)\n",
        "\n",
        "# 3. Use filter to get only even numbers from a list\n",
        "evens = list(filter(lambda x: x % 2 == 0, numbers))\n",
        "\n",
        "squared, product, evens"
