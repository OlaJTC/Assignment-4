        "df_vertical = pd.concat([df1, df2], axis=0)\n",
        "df_vertical\n",
        "\n",
        "# Merge two DataFrames horizontally\n",
        "df_horizontal = pd.concat([df1, df3], axis=1)\n",
        "df_horizontal"
